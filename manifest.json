{
  "manifest_version": 3,
  "name": "Inherited Getters in DevTools",
  "version": "1.0.1",
  "description": "Shows inherited JavaScript getters (such as ArcGIS Accessor properties) at the top level of expanded objects in the Firefox console, the way Chrome DevTools does.",
  "browser_specific_settings": {
    "gecko": {
      "id": "inherited-getters@devtools.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["formatter.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
